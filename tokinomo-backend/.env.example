# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Postgres (Timescale via docker-compose)
DATABASE_URL=postgresql://tokinomo:tokinomo@localhost:5432/tokinomo?schema=public

# Redis (BullMQ / presence later)
REDIS_URL=redis://localhost:6379

# MinIO / S3-compatible object storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=tokinomo
S3_SECRET_ACCESS_KEY=tokinomo_secret
S3_BUCKET=tokinomo
S3_FORCE_PATH_STYLE=true

# EMQX MQTT
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# BetterAuth (wired later)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Resend (email — wired later)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Tokinomo <noreply@example.com>
