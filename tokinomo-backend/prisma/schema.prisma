// Prisma schema — Better Auth + Tokinomo domain
// Auth tables follow Better Auth (email/password + admin + organization plugins).
// Domain tenant_id mirrors Better Auth organizationId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Better Auth core ───────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // admin plugin — PLATFORM_OWNER | PLATFORM_OPERATOR | user (default)
  role       String?   @default("user")
  banned     Boolean?  @default(false)
  banReason  String?   @map("ban_reason")
  banExpires DateTime? @map("ban_expires")

  sessions    Session[]
  accounts    Account[]
  members     Member[]
  invitations Invitation[] @relation("InvitationInviter")

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // organization plugin
  activeOrganizationId String? @map("active_organization_id")

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verification")
}

// ─── Better Auth organization plugin ────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  createdAt DateTime @default(now()) @map("created_at")
  metadata  String?

  members     Member[]
  invitations Invitation[]
  tenant      Tenant?

  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // BRAND_ADMIN | BRAND_STAFF | BRAND_VIEWER (or owner/admin/member aliases)
  role           String
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([organizationId, userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime     @map("expires_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  inviterId      String       @map("inviter_id")
  inviter        User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@map("invitation")
}

// ─── Tokinomo domain ────────────────────────────────────────────────────────

/// Matches business tiers: Basic / Growth / Brand (Enterprise)
enum TenantTier {
  BASIC
  GROWTH
  BRAND
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  SUSPENDED
}

enum DeviceStatus {
  UNASSIGNED
  PROVISIONING
  ONLINE
  OFFLINE
}

enum DeviceEventType {
  DETECTION
  DWELL
  PLAY
  ONLINE
  OFFLINE
}

enum CommandType {
  AUDIO_UPDATE
  PLAY
  REBOOT
  CONFIG
}

enum CommandStatus {
  QUEUED
  SENT
  ACKED
  FAILED
}

/// Brand mirror — id matches Better Auth Organization.id
model Tenant {
  id             String       @id
  organizationId String       @unique @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String       @unique
  tier           TenantTier   @default(BASIC)
  status         TenantStatus @default(ACTIVE)
  /// White-label (Brand tier): logo URL / subdomain slug
  brandLogoUrl   String?      @map("brand_logo_url")
  brandDomain    String?      @map("brand_domain")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  products     Product[]
  locations    Location[]
  devices      Device[]
  audioClips   AudioClip[]
  events       DeviceEvent[]
  subscription Subscription?

  @@map("tenant")
}

/// Per-tenant recurring platform subscription (land-and-expand after 6 mo trial)
model Subscription {
  id                 String             @id @default(cuid())
  tenantId           String             @unique @map("tenant_id")
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tier               TenantTier         @default(BASIC)
  status             SubscriptionStatus @default(TRIAL)
  /// NPR per device / month at current tier
  pricePerDeviceNpr  Int                @map("price_per_device_npr")
  /// Included free months from hardware sale (default 6)
  trialMonths        Int                @default(6) @map("trial_months")
  trialEndsAt        DateTime           @map("trial_ends_at")
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  cancelledAt        DateTime?          @map("cancelled_at")
  notes              String?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@map("subscription")
}

model Product {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  sku       String
  imageKey  String?  @map("image_key")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  devices Device[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@map("product")
}

model Location {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  address   String?
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  devices Device[]

  @@index([tenantId])
  @@map("location")
}

model Device {
  id             String       @id @default(cuid())
  serial         String       @unique
  tenantId       String?      @map("tenant_id")
  locationId     String?      @map("location_id")
  productId      String?      @map("product_id")
  fwVersion      String?      @map("fw_version")
  status         DeviceStatus @default(UNASSIGNED)
  provisionToken String?      @map("provision_token")
  lastSeen       DateTime?    @map("last_seen")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  tenant      Tenant?       @relation(fields: [tenantId], references: [id])
  location    Location?     @relation(fields: [locationId], references: [id])
  product     Product?      @relation(fields: [productId], references: [id])
  events      DeviceEvent[]
  deviceAudio DeviceAudio[]
  commands    Command[]

  @@index([tenantId])
  @@index([status])
  @@map("device")
}

model AudioClip {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  name       String
  storageKey String   @map("storage_key")
  durationMs Int?     @map("duration_ms")
  checksum   String
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deviceAudio DeviceAudio[]

  @@index([tenantId])
  @@map("audio_clip")
}

model DeviceAudio {
  deviceId    String  @map("device_id")
  audioClipId String  @map("audio_clip_id")
  active      Boolean @default(true)

  device    Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  audioClip AudioClip @relation(fields: [audioClipId], references: [id], onDelete: Cascade)

  @@id([deviceId, audioClipId])
  @@map("device_audio")
}

model DeviceEvent {
  id       String          @id @default(cuid())
  deviceId String          @map("device_id")
  tenantId String          @map("tenant_id")
  ts       DateTime        @default(now())
  type     DeviceEventType
  dwellMs  Int?            @map("dwell_ms")
  meta     Json?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, ts])
  @@index([deviceId, ts])
  @@map("device_event")
}

model Command {
  id        String        @id @default(cuid())
  deviceId  String        @map("device_id")
  type      CommandType
  payload   Json
  status    CommandStatus @default(QUEUED)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  ackedAt   DateTime?     @map("acked_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, status])
  @@map("command")
}
